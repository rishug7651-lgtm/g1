PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

PUBLIC_BACKEND_URL=https://your-backend.onrender.com
PUBLIC_FRONTEND_URL=https://your-frontend.onrender.com
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

ADMIN_API_TOKEN=change_me
ADMIN_EMAIL=owner@example.com
MAILERSEND_API_KEY=your_mailersend_key
MAILERSEND_FROM_EMAIL=orders@your-domain.com
MAILERSEND_FROM_NAME=Clickkdesi

GOOGLE_SHEET_ID=your_sheet_id
# Use either GOOGLE_SERVICE_ACCOUNT_JSON, or the split Render vars below.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_SERVICE_ACCOUNT=your_google_project_id
SHEET_RETRY_ENABLED=true
