PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

PUBLIC_BACKEND_URL=https://your-backend.onrender.com
PUBLIC_FRONTEND_URL=https://your-frontend.onrender.com
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

ADMIN_API_TOKEN=change_me
ADMIN_EMAIL=admin@clickkdesistore.in
EMAILJS_SERVICE_ID=service_xxxxx
EMAILJS_TEMPLATE_ID=template_xxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_if_enabled
EMAILJS_FROM_EMAIL=clickkdesi24@gmail.com
EMAILJS_FROM_NAME=Clickkdesi
EMAILJS_CC_EMAIL=admin@clickkdesistore.in

GOOGLE_SHEET_ID=your_sheet_id
# Preferred for Render: add a Secret File named google.json. It mounts at /etc/secrets/google.json.
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/google.json
# Alternative env-only options. Do not commit backend/config/google.json.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID=your_google_project_id
SHEET_RETRY_ENABLED=true
SHEET_RETRY_BATCH_SIZE=10
